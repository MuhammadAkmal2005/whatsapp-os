#############################################
# WhatsApp OS — environment configuration
#
# Copy to .env and fill in. Never commit .env.
# Every variable is parsed and validated at boot by config/env.ts,
# so a missing or malformed value fails the process at startup
# rather than at the first request that needs it.
#############################################

# ── Core ─────────────────────────────────────────────────────────
NODE_ENV=development

# Public base URL of the application. Used for absolute links,
# webhook callback URLs and cookie scoping.
APP_URL=http://localhost:3000

# Human-readable product name shown in the UI and emails.
# The codebase is not coupled to this value.
NEXT_PUBLIC_APP_NAME=WhatsApp OS

# 32+ byte random string. Signs and derives keys for sessions and
# short-lived tokens. Generate with:  openssl rand -base64 48
AUTH_SECRET=

# ── Database ─────────────────────────────────────────────────────
# PostgreSQL 14+ with the pgvector extension available.
DATABASE_URL=postgresql://whatsapp_os:whatsapp_os@localhost:5432/whatsapp_os?schema=public

# Optional separate URL used only by tests. When set, the test
# suite runs against this database and will reset it freely.
TEST_DATABASE_URL=

# ── AI provider ──────────────────────────────────────────────────
# openai | mock
# "mock" is a deterministic offline driver. It is the default in
# development and in tests, so the whole product is runnable with
# no credentials and no network.
AI_PROVIDER=mock

AI_API_KEY=
# Optional. Point at any OpenAI-compatible gateway.
AI_BASE_URL=

# Model routing. Prices live in config/models.ts, not here.
AI_MODEL=gpt-4o-mini
AI_MODEL_FAST=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# Hard ceiling on generated tokens per reply. Cost control.
AI_MAX_OUTPUT_TOKENS=600

# Number of recent messages included in a turn alongside the
# rolling conversation summary. Never the full history.
AI_CONTEXT_MESSAGE_WINDOW=12

# Minimum cosine similarity for a knowledge chunk to be considered
# relevant. Below this, retrieval returns nothing and the agent
# says it does not know rather than answering from a bad match.
AI_RETRIEVAL_MIN_SCORE=0.35

# ── WhatsApp (Meta WhatsApp Business Platform / Cloud API) ───────
# When true, no real messages are ever sent. Outbound sends are
# recorded to the database and an inbound simulator is exposed.
# Keep this true until a verified number is connected.
MOCK_WHATSAPP=true

WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Arbitrary string you choose. Meta echoes it back during webhook
# verification; we compare in constant time.
WHATSAPP_VERIFY_TOKEN=

# From the Meta app dashboard. Used to verify the
# X-Hub-Signature-256 HMAC over the raw webhook body.
META_APP_SECRET=

# ── Background jobs ──────────────────────────────────────────────
# postgres | redis
# The Postgres driver uses FOR UPDATE SKIP LOCKED and needs no
# broker. Redis is not a hard dependency for the MVP.
QUEUE_DRIVER=postgres
REDIS_URL=

# ── File storage ─────────────────────────────────────────────────
# local | s3
# "local" writes to .storage/ on disk and is for development only.
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=whatsapp-os
# Local directory used when STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.storage
# Lifetime in seconds of signed URLs handed to the browser.
STORAGE_SIGNED_URL_TTL=900
# Upload ceiling in bytes. 20 MB.
STORAGE_MAX_UPLOAD_BYTES=20971520

# ── Email ────────────────────────────────────────────────────────
# console | smtp
# "console" prints the message instead of sending it.
EMAIL_PROVIDER=console
EMAIL_FROM="WhatsApp OS <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Payments ─────────────────────────────────────────────────────
# mock | stripe
PAYMENT_PROVIDER=mock
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_PUBLIC_KEY=

# ── Billing ──────────────────────────────────────────────────────
# Length of the free trial in days. Configurable on purpose.
TRIAL_DAYS=14
# Default plan key assigned to a brand-new workspace.
DEFAULT_PLAN=free

# ── Feature flags ────────────────────────────────────────────────
# Gradual rollout. Anything false is absent from the UI entirely,
# never shown as "coming soon".
ENABLE_CAMPAIGNS=false
ENABLE_APPOINTMENTS=false
ENABLE_PAYMENTS=false
ENABLE_VOICE=false
ENABLE_ADVANCED_AI=false
ENABLE_PLATFORM_ADMIN=true

# ── Security ─────────────────────────────────────────────────────
# Session lifetime in days, and the fraction of remaining life at
# which a session is slid forward on use.
SESSION_DURATION_DAYS=30

# scrypt cost. 2^16 with r=8 costs roughly 64 MB and ~100 ms per
# hash. Raise N as hardware improves; existing hashes carry their
# own parameters and keep verifying.
PASSWORD_SCRYPT_COST=65536
PASSWORD_SCRYPT_BLOCK_SIZE=8
PASSWORD_SCRYPT_PARALLELISM=1

# Set false only if you terminate rate limiting at the edge.
RATE_LIMIT_ENABLED=true

# ── Observability ────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
# pretty | json
LOG_FORMAT=pretty
